import time


def linear_search(lst, target):
    """
    TODO (Student):
    Implement a linear search algorithm.

    Requirements:
    - Search the list from beginning to end.
    - Return the index if the target is found.
    - Return -1 if the target is not found.
    - Add comments explaining why linear search
      has O(n) time complexity.
    """
    # Iterate through the list sequentially from index 0 to len(lst) - 1.
    # Time Complexity: O(n) because in the worst-case scenario (the target is
    # at the very end of the list or not present at all), the loop must inspect
    # every single element 'n' one by one.
    for index, value in enumerate(lst):
        if value == target:
            return index
    return -1


def binary_search(lst, target):
    """
    TODO (Student):
    Implement a binary search algorithm.

    Requirements:
    - Assume the list is already sorted.
    - Repeatedly reduce the search space by half.
    - Return the index if the target is found.
    - Return -1 if the target is not found.
    - Add comments explaining how each iteration
      reduces the search space.
    """
    # Initialize pointers representing the inclusive boundaries of the search space.
    low = 0
    high = len(lst) - 1

    # Continue searching as long as the search space is valid (low <= high).
    # Time Complexity: O(log n) because each iteration cuts the remaining search
    # space in half, drastically reducing the maximum number of comparisons.
    while low <= high:
        # Calculate the middle index to split the current search space in two.
        mid = (low + high) // 2
        guess = lst[mid]

        if guess == target:
            return mid
        elif guess < target:
            # Target must be in the upper half; discard the lower half including mid.
            low = mid + 1
        else:
            # Target must be in the lower half; discard the upper half including mid.
            high = mid - 1

    return -1


